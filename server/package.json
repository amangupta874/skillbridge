{
  "name": "skillbridge-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset:test": "dotenv run -f .env.test -- prisma migrate reset --force --skip-seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "zod": "^4.6.7",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "helmet": "^8.3.0",
    "cors": "^2.8.6",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.7.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "vitest": "^5.0.5",
    "supertest": "^7.3.1",
    "dotenv-cli": "^8"
  },
  "engines": {
    "node": ">=22"
  }
}
